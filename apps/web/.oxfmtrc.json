{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxfmt/schema.json",
  "arrowParens": "always",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": ["**/.next/**", "**/node_modules/**", "**/dist/**"]
}
